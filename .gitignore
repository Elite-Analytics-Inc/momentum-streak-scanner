# Generated by every run — one parquet per output, plus the shipped dashboard copy.
output/

# Python
__pycache__/
*.pyc
.venv/

# The local ground: pretend or copied data never leaves the laptop.
data/

# The platform's own package, which came inside the starter download. Private: it stays on the
# laptop, and the repository holds only the analysis.
*.whl

# The market-data loader's download cache (tools/load_market_data.py): laptop only.
.loader_cache/

# Browser-check leftovers and the preview log: never part of the analysis.
.playwright-mcp/
.preview.log
